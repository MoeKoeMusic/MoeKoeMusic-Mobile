{
  "name": "moekoe",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "description": "MoeKoe mobile app",
  "scripts": {
    "start": "expo start",
    "generate:mobile-api": "node ./scripts/generate-mobile-api-entry.mjs",
    "release:version": "node ./scripts/update-version.mjs",
    "release:ota": "npx eas-cli update --channel production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios:dev": "npx eas-cli build --profile development --platform ios"
  },
  "private": true,
  "license": "GPL-2.0-only",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@tamagui/config": "^2.4.6",
    "buffer": "^6.0.3",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "^2.4.6"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
